# ============================================================
# Dr.Clash — E2E Test Environment Variables
# Copy to .env.local for local runs. NEVER commit secrets.
# ============================================================

# E2E target URL
E2E_BASE_URL=http://localhost:4200

# Server command (Playwright will start this automatically)
E2E_SERVER_CMD=npx ng serve --port 4200

# Headless: true = no browser UI, false = see the tests
E2E_HEADLESS=true

# Test accounts (use throwaway accounts only)
E2E_TEST_EMAIL=e2e-test@example.com
E2E_TEST_USERNAME=e2etester
E2E_TEST_PASSWORD=TestPass123!

# Admin credentials
E2E_ADMIN_USERNAME=admin
E2E_ADMIN_PASSWORD=adminpass123
