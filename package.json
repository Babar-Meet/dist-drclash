{
  "name": "dist-drclash",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --no-watch",
    "test:unit:watch": "ng test",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "cross-env E2E_HEADLESS=false npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:gui": "npx playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:debug": "npx playwright test --config e2e/playwright.config.ts --debug",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:clean": "npx playwright test --config e2e/playwright.config.ts --reporter=list"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.2"
  }
}
